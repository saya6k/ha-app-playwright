#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# Headful Chromium on :99 with CDP on loopback only. The profile lives in
# /data so logins survive restarts and are part of HA backups.
set -euo pipefail

# Read app options straight from /data/options.json (Supervisor writes it;
# bashio::config needs the Supervisor API, which bare docker runs lack).
opt() { jq -r --arg k "$1" '.[$k] // empty' /data/options.json 2>/dev/null || true; }

VIEWPORT="$(opt viewport)"
[[ "${VIEWPORT}" =~ ^[0-9]{3,4}x[0-9]{3,4}$ ]] || VIEWPORT=1280x800
LANGUAGE="$(opt browser_language)"
[[ "${LANGUAGE}" =~ ^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$ ]] || LANGUAGE=en-US
PROFILE=/data/profile

for _ in $(seq 1 40); do
  [ -S /tmp/.X11-unix/X99 ] && break
  sleep 0.25
done

mkdir -p "${PROFILE}"
chmod 700 "${PROFILE}"
# Only one Chromium ever uses this profile; a lock left by a crash would make
# the next start refuse the profile.
rm -f "${PROFILE}/SingletonLock" "${PROFILE}/SingletonSocket" "${PROFILE}/SingletonCookie"

FLAGS=(
  --no-sandbox
  --disable-dev-shm-usage
  # Without it the mesa GL path returns blank screenshots of background tabs (PoC).
  --disable-gpu
  --no-first-run
  --no-default-browser-check
  "--user-data-dir=${PROFILE}"
  --remote-debugging-address=127.0.0.1
  --remote-debugging-port=9222
  "--window-position=0,0"
  "--window-size=${VIEWPORT/x/,}"
  "--lang=${LANGUAGE}"
  "--accept-lang=${LANGUAGE}"
)

PROXY="$(opt outgoing_proxy)"
if [ -n "${PROXY}" ]; then
  FLAGS+=("--proxy-server=${PROXY}" "--proxy-bypass-list=<-loopback>")
  echo "[chromium] outgoing proxy enabled"
fi

echo "[chromium] starting (CDP 127.0.0.1:9222, ${VIEWPORT}, ${LANGUAGE}) …"
env -u SUPERVISOR_TOKEN -u HASSIO_TOKEN DISPLAY=:99 chromium-browser "${FLAGS[@]}" about:blank &
CHROME_PID=$!

# Not exec'd: s6's SIGTERM must reach this script, so Chromium is closed via
# CDP and writes cookies to disk. A plain SIGTERM loses logins made in the
# last ~30 s (verified in the image).
graceful_stop() {
  echo "[chromium] closing via CDP …"
  node /opt/chromium/close.mjs || true
  for _ in $(seq 1 40); do
    kill -0 "${CHROME_PID}" 2>/dev/null || exit 0
    sleep 0.25
  done
  kill -TERM "${CHROME_PID}" 2>/dev/null || true
  exit 0
}
trap graceful_stop TERM INT

wait "${CHROME_PID}"
