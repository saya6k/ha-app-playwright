#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# Shares display :99 over VNC on loopback only; the panel is the sole client.
set -euo pipefail

for _ in $(seq 1 40); do
  [ -S /tmp/.X11-unix/X99 ] && break
  sleep 0.25
done

echo "[x11vnc] sharing :99 on 127.0.0.1:5900 …"
exec x11vnc -display :99 -localhost -rfbport 5900 -shared -forever -nopw -quiet
